# ─────────────────────────────────────────────────────────────────────────────
# Public. Everything with a VITE_ prefix is INLINED INTO THE BROWSER BUNDLE and
# is readable in the page source of every visit. Never put a secret here.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SITE_URL=https://incillum.com
VITE_CONTACT_EMAIL=hello@incillum.com

# Google Tag Manager container. Optional — leave it empty and no analytics
# script, dataLayer, cookie or third-party request is added to the page, which
# is what you want locally and in preview deployments.
# A container ID is public by design, so this belongs on the public side.
VITE_GTM_ID=

# PostHog. Optional and independent of GTM — empty means the snippet is not
# rendered at all. The project API key (phc_…) is public by design; it only
# grants event ingestion. Get it from Project settings → General → Project ID,
# or the pre-filled snippet at Project settings → Web snippet.
VITE_POSTHOG_KEY=
# Ingestion host. Defaults to https://us.i.posthog.com — set it to
# https://eu.i.posthog.com for an EU project, or a reverse-proxy origin.
VITE_POSTHOG_HOST=

# ─────────────────────────────────────────────────────────────────────────────
# Server only. Read from process.env inside server functions and NEVER inlined
# into the browser bundle. Set these in your host's environment settings, not
# in a committed file.
# ─────────────────────────────────────────────────────────────────────────────

# Brevo API key — https://app.brevo.com/settings/keys/api
# 300 emails/day free, permanently, no card. Without it, waitlist signups are
# written to the server log instead of emailed: nothing breaks, the record just
# lands somewhere less convenient.
# Switching provider? See the swap table at the top of src/server/notify.ts.
BREVO_API_KEY=

# Where waitlist notifications are delivered. Your inbox — not the joiner's.
WAITLIST_NOTIFY_TO=you@incillum.com

# The From address. It MUST be a sender verified in Brevo (Senders, Domains &
# Dedicated IPs → Senders). An unverified sender is accepted by the API and then
# silently not delivered, which is the worst failure shape available.
WAITLIST_NOTIFY_FROM=waitlist@incillum.com

# ── Supabase ─────────────────────────────────────────────────────────────────
# The durable copy of a signup, written server-side beside the Brevo mail. Both
# values are needed together; with either missing, signups are logged instead of
# stored — nothing breaks. Run supabase/migrations/*_waitlist.sql once first.
#
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co (Project settings → Data API).
SUPABASE_URL=
# The service_role key (Project settings → API keys). It bypasses row-level
# security, so it is server-only in the strongest sense — never prefix it VITE_,
# never expose it to the browser. NOT the publishable / anon key.
SUPABASE_SERVICE_ROLE_KEY=
