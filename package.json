{
  "name": "incillum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Incillum — the pre-launch site for incillum.com",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@9.15.9",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3200",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview --port 3200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.83.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.62.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "jsdom": "^28.0.1",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "lightningcss", "unrs-resolver", "@tailwindcss/oxide"]
  }
}
